[Unit]
Description=RX BIBI own local token classifier (optional, staging)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rxcloud
Group=rxcloud
WorkingDirectory=/opt/rxcloud/vexorio
EnvironmentFile=/etc/rxcloud/rxcloud.env
ExecStart=/usr/bin/node /opt/rxcloud/vexorio/rx-bibi-own-inference.cjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/rxcloud/vexorio
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
