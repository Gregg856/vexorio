# RX CLOUD test/staging configuration — copy ONLY to /etc/rxcloud/rxcloud.env on your own server
# Do not commit real credentials.
HOST=127.0.0.1
PORT=8787
SUPABASE_URL=https://REPLACE-WITH-STAGING-PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_STAGING_ANON_KEY
RX_ADMIN_USER_ID=
RX_GITHUB_DISPATCH_TOKEN=
VIEW_COUNT_ENABLED=false
VIEW_COUNT_SECRET=
RX_AI_ENABLED=false
# Do not configure SUPABASE_SERVICE_ROLE_KEY until permissions are audited.

# RX Brain memory bridge (optional; read-only, self-hosted).
# Keep the actual token in the private server environment, never in Git.
# RX_QUEEN_LOCAL_TOKEN must be at least 32 characters.
RX_QUEEN_LOCAL_TOKEN=
# HTTPS endpoint on your existing RX CLOUD host (no query string).
# Must end with /__rxcloud/bibi/brain-memory.
RX_CLOUD_BRAIN_MEMORY_URL=
# Private local snapshot written by your existing RX Brain store.
# The server does not automatically create training data.
RX_BRAIN_MEMORY_FILE=

# Optional LOCAL inference backend on the same RX CLOUD host (disabled by default).
# Set true only after an inference service is installed, verified and bound to 127.0.0.1.
# The service must accept POST /infer with {"message":"..."} and return {"answer":"..."}.
# No remote model URL, no secrets in this file, no automatic model installation.
RX_BIBI_MODEL_ENABLED=false
RX_BIBI_MODEL_PORT=

# Own RX BIBI model runtime (STAGING ONLY; set real values privately on server).
# Required for the separate rx-bibi-model.service process.
RX_BIBI_TRAINING_FILE=
# Same loopback port must be used by RX CLOUD and the model service.
# Example: 8797 (verify unused on host).
# RX_BIBI_MODEL_PORT=8797
# RX_BIBI_MODEL_ENABLED=true
# Optional model-first mode in the existing authenticated chat, only after tests.
RX_BIBI_CLIENT_MODEL_FIRST=false
# Optional training progress preview, separate from model inference.
RX_BIBI_HISTORY_FILE=
RX_BIBI_HOLDOUT_FILE=
